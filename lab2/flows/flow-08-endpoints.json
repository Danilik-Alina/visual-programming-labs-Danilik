    {
        "id": "43bd4843c8c8cc4e",
        "type": "function",
        "z": "f4dbda25b77fcf12",
        "name": "function 5",
        "func": "const id = Number(msg.req.params.id);\nconst limit = msg.req.query.limit ? Number(msg.req.query.limit) : 10;\n\n// Проверка 1: id должно быть числом\nif (isNaN(id)) {\n    msg.statusCode = 400;\n    msg.headers = { \"Content-Type\": \"application/json; charset=utf-8\" };\n    msg.payload = { error: \"Bad Request\", message: \"id must be a number\" };\n    return msg;\n}\n\n// Проверка 2: id не должно быть больше 100\nif (id > 100) {\n    msg.statusCode = 404;\n    msg.headers = { \"Content-Type\": \"application/json; charset=utf-8\" };\n    msg.payload = { error: \"Not Found\", message: \"item with id \" + id + \" not found\" };\n    return msg;\n}\n\n// Успешный ответ\nmsg.statusCode = 200;\nmsg.headers = { \"Content-Type\": \"application/json; charset=utf-8\" };\nmsg.payload = {\n    id: id,\n    name: \"item-\" + id,\n    limit: limit,\n    status: \"ok\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
