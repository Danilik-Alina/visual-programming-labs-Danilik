        "z": "99f408d11e2eaae0",
        "name": "function 2",
        "func": "const input = Number(msg.payload);\n\n// Строим массив от 1 до input\nconst numbers = [];\nfor (let i = 1; i <= input; i++) {\n    numbers.push(i);\n}\n\n// Считаем сумму всех чисел массива\nlet sum = 0;\nfor (let i = 0; i < numbers.length; i++) {\n    sum += numbers[i];\n}\n\n// Определяем чётность\nlet parity;\nif (input % 2 === 0) {\n    parity = \"чётное\";\n} else {\n    parity = \"нечётное\";\n}\n\nconst result = {\n    input: input,\n    parity: parity,\n    sum: sum,\n    numbers: numbers\n};\n\nmsg.payload = result;\nreturn msg;",
